<%- include('../cabecalho')%>

    <div>
        <h3>Alterar filme</h3>
        <form action="/filme/upd/<%= filme.id %>" method="POST">
            <p>ID</p>
            <input type="text" name="id" value="<%=filme.id%>">
            <p>Nome</p>
            <input type="text" placeholder="Nome do filme..." name="nome" value="<%=filme.nome%>">

            <p>Gênero</p>
            <select name="genero" value="<%=filme.genero%>">
                <option value="">Selecione...</option>
                <option value="Ação">Ação</option>
                <option value="Comédia">Comédia</option>
                <option value="Drama">Drama</option>
                <option value="Terror">Terror</option>
                <option value="Terror">Romance</option>
                <option value="Ficção científica">Ficção científica</option>
            </select>

            <p>Descrição</p>
            <textarea placeholder="Descrição do filme..." name="descricao" value="<%=filme.descricao%>"></textarea>

            <p>Duração (minutos)</p>
            <input type="number" value="0" name="duracao" value="<%=filme.duracao%>">

            <p>Ano de Lançamento</p>
            <input type="number" value="2026" name="anoLancamento" value="<%=filme.anoLancamento%>">

            <p>Classificação Indicativa</p>
            <select name="classificacao" value="<%=filme.classificacao%>">
                <option value="">Selecione...</option>
                <option value="Livre">Livre</option>
                <option value="10 anos">10 anos</option>
                <option value="12 anos">12 anos</option>
                <option value="14 anos">14 anos</option>
                <option value="16 anos">16 anos</option>
                <option value="18 anos">18 anos</option>
            </select>
            <p>foto</p>
            <input type="file" name="foto" accept="image/png" value="<%=filme.foto%>">
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset" onclick="window.history.back()">Cancelar</button>
        </form>
    </div>
    </body>

    </html>